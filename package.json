{
  "name": "helpdesk-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "ng serve --proxy-config proxy.conf.json",
    "backend": "node backend/index.js",
    "build": "ng build --configuration production --output-path=dist/helpdesk-v2",
    "build:vercel": "npm run prebuild && ng build --configuration production --output-path=dist/helpdesk-v2",
    "prebuild": "npm install",
    "postinstall": "npm run ensure-quill",
    "ensure-quill": "npm list quill@2.0.3 || npm install quill@2.0.3 && npm list ngx-quill@26.0.10 || npm install ngx-quill@26.0.10",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.14",
    "@angular/material-moment-adapter": "^18.2.14",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@highcharts/dashboards": "^3.0.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "crypto-js": "^4.2.0",
    "firebase": "^10.14.1",
    "highcharts": "^12.0.2",
    "highcharts-angular": "^4.0.1",
    "jspdf": "^2.5.2",
    "moment": "^2.30.1",
    "ngx-mask": "^19.0.7",
    "ngx-quill": "^26.0.10",
    "quill": "^2.0.3",
    "quill-delta-to-html": "^0.12.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vanilla-tilt": "^1.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.19",
    "@angular/cli": "^18.2.19",
    "@angular/compiler-cli": "^18.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/highcharts": "^5.0.44",
    "@types/jasmine": "~5.1.0",
    "@types/quill": "^2.0.10",
    "concurrently": "^9.2.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}