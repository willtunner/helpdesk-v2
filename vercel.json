{
  "buildCommand": "npm install --legacy-peer-deps --ignore-scripts && npm run build",
  "outputDirectory": "dist/helpdesk-v2/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.quilljs.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline' https://cdn.quilljs.com; font-src 'self' https://cdn.quilljs.com;"
        }
      ]
    }
  ]
}
